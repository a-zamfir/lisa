{
  "tools": [
    {
      "id": "outlook_get_calendar_events",
      "name": "Get calendar events",
      "description": "Get calendar events within a date range.",
      "friendly_desc": "would like to check your calendar.",
      "command": "scripts/run.py",
      "cli_args": ["--tool", "outlook_get_calendar_events"],
      "args_schema": {
        "type": "object",
        "properties": {
          "days_ahead": { "type": "integer" },
          "days_back": { "type": "integer" },
          "max_results": { "type": "integer" }
        }
      },
      "read_only": true,
      "requires_approval": false,
      "timeout_ms": 20000,
      "max_output_kb": 256
    },
