<!-- File: Host.Win/Themes/DarkTheme.xaml -->
<!-- Windows 11 Fluent Design - Dark Theme -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════════════
         DESIGN SYSTEM: Windows 11 Fluent Dark

         Elevation System:
         - Base Layer:     #202020 (main background)
         - Layer 1:        #2D2D2D (cards, panels)
         - Layer 2:        #383838 (elevated elements, buttons)
         - Layer 3:        #454545 (hover states, active elements)

         Typography: Segoe UI Variable (fallback: Segoe UI)
         Corner Radius: 8px (standard), 12px (large containers)
         Spacing Grid: 4px base unit
    ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Base Surface Colors -->
    <Color x:Key="OverlayBackgroundColor">#FF202020</Color>
    <Color x:Key="OverlayBorderColor">#FF3D3D3D</Color>
    <Color x:Key="OverlayForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="SubtleTextColor">#FF9D9D9D</Color>

    <!-- Panel & Content Backgrounds -->
    <Color x:Key="PanelBackgroundColor">#FF2D2D2D</Color>
    <Color x:Key="ContentBackgroundColor">#FF272727</Color>

    <!-- Interactive Element Colors -->
    <Color x:Key="ButtonBackgroundColor">#FF383838</Color>
    <Color x:Key="ButtonBorderColor">#FF4A4A4A</Color>
    <Color x:Key="TabBorderColor">#00FFFFFF</Color>
    <Color x:Key="ActionButtonBorderColor">#FF4A4A4A</Color>
    <Color x:Key="IconButtonBorderColor">#FF4A4A4A</Color>
    <Color x:Key="InputBorderColor">#FF4A4A4A</Color>

    <!-- Active/Hover States -->
    <Color x:Key="ButtonActiveBackgroundColor">#FF454545</Color>
    <Color x:Key="ButtonActiveBorderColor">#FF60CDFF</Color>

    <!-- Primary Action (Accent) -->
    <Color x:Key="PrimaryButtonBackgroundColor">#FF60CDFF</Color>
    <Color x:Key="PrimaryButtonHoverColor">#FF4CC2FF</Color>
    <Color x:Key="PrimaryButtonTextColor">#FF000000</Color>

    <!-- Input Focus -->
    <Color x:Key="InputFocusBorderColor">#FF60CDFF</Color>
    <Color x:Key="RadioCheckedFillColor">#FF60CDFF</Color>

    <!-- Chat Bubbles - Enhanced depth with subtle elevation -->
    <Color x:Key="AssistantBubbleBackgroundColor">#FF2A2A2A</Color>
    <Color x:Key="AssistantBubbleForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="AssistantBubbleBorderColor">#FF3A3A3A</Color>
    <Color x:Key="UserBubbleBackgroundColor">#FF363636</Color>
    <Color x:Key="UserBubbleForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="UserBubbleBorderColor">#FF424242</Color>

    <!-- Popup/Flyout -->
    <Color x:Key="PopupBackgroundColor">#FF2D2D2D</Color>

    <!-- Status Colors (Semantic) -->
    <Color x:Key="ApprovalAcceptedBackgroundColor">#FF0F6B3A</Color>
    <Color x:Key="ApprovalAcceptedBorderColor">#FF0D5C32</Color>
    <Color x:Key="ApprovalAcceptedForegroundColor">#FF6EE7A0</Color>
    <Color x:Key="ApprovalRejectedBackgroundColor">#FF8B2942</Color>
    <Color x:Key="ApprovalRejectedBorderColor">#FF7A2439</Color>
    <Color x:Key="ApprovalRejectedForegroundColor">#FFFCA5A5</Color>
    <Color x:Key="StatusReadyColor">#FF6EE7A0</Color>
    <Color x:Key="StatusOfflineColor">#FFFF6B6B</Color>

    <!-- ═══════════════════════════════════════════════════════════════════════════
         BRUSH DEFINITIONS
    ═══════════════════════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="OverlayBackground" Color="{StaticResource OverlayBackgroundColor}"/>
    <SolidColorBrush x:Key="OverlayBorder" Color="{StaticResource OverlayBorderColor}"/>
    <SolidColorBrush x:Key="OverlayForeground" Color="{StaticResource OverlayForegroundColor}"/>
    <SolidColorBrush x:Key="SubtleText" Color="{StaticResource SubtleTextColor}"/>
    <SolidColorBrush x:Key="PanelBackground" Color="{StaticResource PanelBackgroundColor}"/>
    <SolidColorBrush x:Key="ContentBackground" Color="{StaticResource ContentBackgroundColor}"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource ButtonBackgroundColor}"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="{StaticResource ButtonBorderColor}"/>
    <SolidColorBrush x:Key="TabBorder" Color="{StaticResource TabBorderColor}"/>
    <SolidColorBrush x:Key="ActionButtonBorder" Color="{StaticResource ActionButtonBorderColor}"/>
    <SolidColorBrush x:Key="IconButtonBorder" Color="{StaticResource IconButtonBorderColor}"/>
    <SolidColorBrush x:Key="InputBorder" Color="{StaticResource InputBorderColor}"/>
    <SolidColorBrush x:Key="ButtonActiveBackground" Color="{StaticResource ButtonActiveBackgroundColor}"/>
    <SolidColorBrush x:Key="ButtonActiveBorder" Color="{StaticResource ButtonActiveBorderColor}"/>
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="{StaticResource ButtonActiveBackgroundColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonBackground" Color="{StaticResource PrimaryButtonBackgroundColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonHover" Color="{StaticResource PrimaryButtonHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonForeground" Color="{StaticResource PrimaryButtonTextColor}"/>
    <SolidColorBrush x:Key="InputFocusBorder" Color="{StaticResource InputFocusBorderColor}"/>
    <SolidColorBrush x:Key="RadioCheckedFill" Color="{StaticResource RadioCheckedFillColor}"/>
    <SolidColorBrush x:Key="AssistantBubbleBackground" Color="{StaticResource AssistantBubbleBackgroundColor}"/>
    <SolidColorBrush x:Key="AssistantBubbleForeground" Color="{StaticResource AssistantBubbleForegroundColor}"/>
    <SolidColorBrush x:Key="AssistantBubbleBorder" Color="{StaticResource AssistantBubbleBorderColor}"/>
    <SolidColorBrush x:Key="UserBubbleBackground" Color="{StaticResource UserBubbleBackgroundColor}"/>
    <SolidColorBrush x:Key="UserBubbleForeground" Color="{StaticResource UserBubbleForegroundColor}"/>
    <SolidColorBrush x:Key="UserBubbleBorder" Color="{StaticResource UserBubbleBorderColor}"/>
    <SolidColorBrush x:Key="PopupBackground" Color="{StaticResource PopupBackgroundColor}"/>
    <SolidColorBrush x:Key="PopupBorder" Color="{StaticResource OverlayBorderColor}"/>
    <SolidColorBrush x:Key="ApprovalAcceptedBackground" Color="{StaticResource ApprovalAcceptedBackgroundColor}"/>
    <SolidColorBrush x:Key="ApprovalAcceptedBorder" Color="{StaticResource ApprovalAcceptedBorderColor}"/>
    <SolidColorBrush x:Key="ApprovalAcceptedForeground" Color="{StaticResource ApprovalAcceptedForegroundColor}"/>
    <SolidColorBrush x:Key="ApprovalRejectedBackground" Color="{StaticResource ApprovalRejectedBackgroundColor}"/>
    <SolidColorBrush x:Key="ApprovalRejectedBorder" Color="{StaticResource ApprovalRejectedBorderColor}"/>
    <SolidColorBrush x:Key="ApprovalRejectedForeground" Color="{StaticResource ApprovalRejectedForegroundColor}"/>
    <SolidColorBrush x:Key="ModeButtonActiveForeground" Color="{StaticResource OverlayForegroundColor}"/>
    <SolidColorBrush x:Key="StatusReadyBrush" Color="{StaticResource StatusReadyColor}"/>
    <SolidColorBrush x:Key="StatusOfflineBrush" Color="{StaticResource StatusOfflineColor}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════
         CONTROL STYLES
    ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Mode Navigation Button - Windows 11 Tab Style -->
    <Style x:Key="ModeButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="4 0"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource SubtleText}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="12 8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonBackground}"/>
                            <Setter Property="Foreground" Value="{StaticResource OverlayForeground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonActiveBackground}"/>
                            <Setter Property="Foreground" Value="{StaticResource OverlayForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Typography Styles -->
    <Style x:Key="TitleLargeTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource OverlayForeground}"/>
    </Style>
</ResourceDictionary>
