<!-- File: Host.Win/Themes/DarkTheme.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="OverlayBackgroundColor">#FF1F1F1F</Color>
    <Color x:Key="OverlayBorderColor">#FF2F2F2F</Color>
    <Color x:Key="OverlayForegroundColor">#FFE5E7EB</Color>
    <Color x:Key="SubtleTextColor">#FF9CA3AF</Color>
    <Color x:Key="PanelBackgroundColor">#FF262626</Color>
    <Color x:Key="ContentBackgroundColor">#FF242424</Color>
    <Color x:Key="ButtonBackgroundColor">#FF2A2A2A</Color>
    <Color x:Key="ButtonBorderColor">#FF303030</Color>
    <Color x:Key="ButtonActiveBackgroundColor">#FF2F2F2F</Color>
    <Color x:Key="ButtonActiveBorderColor">#FF3A3A3A</Color>
    <Color x:Key="PrimaryButtonBackgroundColor">#FF343434</Color>
    <Color x:Key="PrimaryButtonHoverColor">#FF3A3A3A</Color>
    <Color x:Key="PrimaryButtonTextColor">#FFF3F4F6</Color>
    <Color x:Key="AssistantBubbleBackgroundColor">#FF262626</Color>
    <Color x:Key="AssistantBubbleForegroundColor">#FFE5E7EB</Color>
    <Color x:Key="AssistantBubbleBorderColor">#FF303030</Color>
    <Color x:Key="UserBubbleBackgroundColor">#FF343434</Color>
    <Color x:Key="UserBubbleForegroundColor">#FFF3F4F6</Color>
    <Color x:Key="StatusReadyColor">#FF22C55E</Color>
    <Color x:Key="StatusOfflineColor">#FFEF4444</Color>

    <SolidColorBrush x:Key="OverlayBackground" Color="{StaticResource OverlayBackgroundColor}"/>
    <SolidColorBrush x:Key="OverlayBorder" Color="{StaticResource OverlayBorderColor}"/>
    <SolidColorBrush x:Key="OverlayForeground" Color="{StaticResource OverlayForegroundColor}"/>
    <SolidColorBrush x:Key="SubtleText" Color="{StaticResource SubtleTextColor}"/>
    <SolidColorBrush x:Key="PanelBackground" Color="{StaticResource PanelBackgroundColor}"/>
    <SolidColorBrush x:Key="ContentBackground" Color="{StaticResource ContentBackgroundColor}"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource ButtonBackgroundColor}"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="{StaticResource ButtonBorderColor}"/>
    <SolidColorBrush x:Key="ButtonActiveBackground" Color="{StaticResource ButtonActiveBackgroundColor}"/>
    <SolidColorBrush x:Key="ButtonActiveBorder" Color="{StaticResource ButtonActiveBorderColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonBackground" Color="{StaticResource PrimaryButtonBackgroundColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonHover" Color="{StaticResource PrimaryButtonHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonForeground" Color="{StaticResource PrimaryButtonTextColor}"/>
    <SolidColorBrush x:Key="AssistantBubbleBackground" Color="{StaticResource AssistantBubbleBackgroundColor}"/>
    <SolidColorBrush x:Key="AssistantBubbleForeground" Color="{StaticResource AssistantBubbleForegroundColor}"/>
    <SolidColorBrush x:Key="AssistantBubbleBorder" Color="{StaticResource AssistantBubbleBorderColor}"/>
    <SolidColorBrush x:Key="UserBubbleBackground" Color="{StaticResource UserBubbleBackgroundColor}"/>
    <SolidColorBrush x:Key="UserBubbleForeground" Color="{StaticResource UserBubbleForegroundColor}"/>
    <SolidColorBrush x:Key="ModeButtonActiveForeground" Color="{StaticResource OverlayForegroundColor}"/>
    <SolidColorBrush x:Key="StatusReadyBrush" Color="{StaticResource StatusReadyColor}"/>
    <SolidColorBrush x:Key="StatusOfflineBrush" Color="{StaticResource StatusOfflineColor}"/>

    <Style x:Key="ModeButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="6 0"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="{StaticResource ButtonBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ButtonBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource OverlayForeground}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Padding="10 6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ButtonActiveBorder}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonActiveBackground}"/>
                            <Setter Property="Foreground" Value="{StaticResource OverlayForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
