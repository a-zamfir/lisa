<!-- File: Host.Win/Themes/GreenTheme.xaml -->
<!-- Windows 11 Fluent Design - Emerald Theme -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════════════
         DESIGN SYSTEM: Windows 11 Fluent Emerald

         A nature-inspired theme with professional emerald tones.
         Follows the same elevation and spacing principles as the core themes.

         Elevation System:
         - Base Layer:     #0D3D2E (deep emerald)
         - Layer 1:        #145142 (emerald card)
         - Layer 2:        #1B6656 (elevated elements)
         - Layer 3:        #22806A (hover states)
    ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Base Surface Colors -->
    <Color x:Key="OverlayBackgroundColor">#FF0D3D2E</Color>
    <Color x:Key="OverlayBorderColor">#FF1B6656</Color>
    <Color x:Key="OverlayForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="SubtleTextColor">#FF86EFAC</Color>

    <!-- Panel & Content Backgrounds -->
    <Color x:Key="PanelBackgroundColor">#FF145142</Color>
    <Color x:Key="ContentBackgroundColor">#FF103B30</Color>

    <!-- Interactive Element Colors -->
    <Color x:Key="ButtonBackgroundColor">#FF1B6656</Color>
    <Color x:Key="ButtonBorderColor">#FF22806A</Color>
    <Color x:Key="TabBorderColor">#00FFFFFF</Color>
    <Color x:Key="ActionButtonBorderColor">#FF22806A</Color>
    <Color x:Key="IconButtonBorderColor">#FF22806A</Color>
    <Color x:Key="InputBorderColor">#FF22806A</Color>

    <!-- Active/Hover States -->
    <Color x:Key="ButtonActiveBackgroundColor">#FF22806A</Color>
    <Color x:Key="ButtonActiveBorderColor">#FF34D399</Color>

    <!-- Primary Action (Accent - vibrant teal) -->
    <Color x:Key="PrimaryButtonBackgroundColor">#FF10B981</Color>
    <Color x:Key="PrimaryButtonHoverColor">#FF14D89C</Color>
    <Color x:Key="PrimaryButtonTextColor">#FF052E1B</Color>

    <!-- Input Focus -->
    <Color x:Key="InputFocusBorderColor">#FF34D399</Color>
    <Color x:Key="RadioCheckedFillColor">#FF34D399</Color>

    <!-- Chat Bubbles -->
    <Color x:Key="AssistantBubbleBackgroundColor">#FF145142</Color>
    <Color x:Key="AssistantBubbleForegroundColor">#FFDCFCE7</Color>
    <Color x:Key="AssistantBubbleBorderColor">#FF1B6656</Color>
    <Color x:Key="UserBubbleBackgroundColor">#FF10B981</Color>
    <Color x:Key="UserBubbleForegroundColor">#FF052E1B</Color>

    <!-- Popup/Flyout -->
    <Color x:Key="PopupBackgroundColor">#FF103B30</Color>
    <Color x:Key="PopupBorderTopColor">#FF22806A</Color>
    <Color x:Key="PopupBorderMidColor">#FF1B6656</Color>
    <Color x:Key="PopupBorderBottomColor">#FF145142</Color>

    <!-- Status Colors -->
    <Color x:Key="ApprovalAcceptedBackgroundColor">#FF059669</Color>
    <Color x:Key="ApprovalAcceptedBorderColor">#FF047857</Color>
    <Color x:Key="ApprovalAcceptedForegroundColor">#FFDCFCE7</Color>
    <Color x:Key="ApprovalRejectedBackgroundColor">#FF991B1B</Color>
    <Color x:Key="ApprovalRejectedBorderColor">#FF7F1D1D</Color>
    <Color x:Key="ApprovalRejectedForegroundColor">#FFFEE2E2</Color>
    <Color x:Key="StatusReadyColor">#FF34D399</Color>
    <Color x:Key="StatusOfflineColor">#FFFCA5A5</Color>

    <!-- ═══════════════════════════════════════════════════════════════════════════
         BRUSH DEFINITIONS
    ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Subtle gradient for depth -->
    <LinearGradientBrush x:Key="OverlayBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF0A3225" Offset="0"/>
        <GradientStop Color="#FF0D3D2E" Offset="0.5"/>
        <GradientStop Color="#FF0B3528" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="OverlayBorder" Color="{StaticResource OverlayBorderColor}"/>
    <SolidColorBrush x:Key="OverlayForeground" Color="{StaticResource OverlayForegroundColor}"/>
    <SolidColorBrush x:Key="SubtleText" Color="{StaticResource SubtleTextColor}"/>
    <SolidColorBrush x:Key="PanelBackground" Color="{StaticResource PanelBackgroundColor}"/>
    <SolidColorBrush x:Key="ContentBackground" Color="{StaticResource ContentBackgroundColor}"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource ButtonBackgroundColor}"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="{StaticResource ButtonBorderColor}"/>
    <SolidColorBrush x:Key="TabBorder" Color="{StaticResource TabBorderColor}"/>
    <SolidColorBrush x:Key="ActionButtonBorder" Color="{StaticResource ActionButtonBorderColor}"/>
    <SolidColorBrush x:Key="IconButtonBorder" Color="{StaticResource IconButtonBorderColor}"/>
    <SolidColorBrush x:Key="InputBorder" Color="{StaticResource InputBorderColor}"/>
    <SolidColorBrush x:Key="ButtonActiveBackground" Color="{StaticResource ButtonActiveBackgroundColor}"/>
    <SolidColorBrush x:Key="ButtonActiveBorder" Color="{StaticResource ButtonActiveBorderColor}"/>
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="{StaticResource ButtonActiveBackgroundColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonBackground" Color="{StaticResource PrimaryButtonBackgroundColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonHover" Color="{StaticResource PrimaryButtonHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonForeground" Color="{StaticResource PrimaryButtonTextColor}"/>
    <SolidColorBrush x:Key="InputFocusBorder" Color="{StaticResource InputFocusBorderColor}"/>
    <SolidColorBrush x:Key="RadioCheckedFill" Color="{StaticResource RadioCheckedFillColor}"/>
    <SolidColorBrush x:Key="AssistantBubbleBackground" Color="{StaticResource AssistantBubbleBackgroundColor}"/>
    <SolidColorBrush x:Key="AssistantBubbleForeground" Color="{StaticResource AssistantBubbleForegroundColor}"/>
    <SolidColorBrush x:Key="AssistantBubbleBorder" Color="{StaticResource AssistantBubbleBorderColor}"/>
    <SolidColorBrush x:Key="UserBubbleBackground" Color="{StaticResource UserBubbleBackgroundColor}"/>
    <SolidColorBrush x:Key="UserBubbleForeground" Color="{StaticResource UserBubbleForegroundColor}"/>
    <SolidColorBrush x:Key="PopupBackground" Color="{StaticResource PopupBackgroundColor}"/>
    <LinearGradientBrush x:Key="PopupBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource PopupBorderTopColor}" Offset="0"/>
        <GradientStop Color="{StaticResource PopupBorderMidColor}" Offset="0.5"/>
        <GradientStop Color="{StaticResource PopupBorderBottomColor}" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ApprovalAcceptedBackground" Color="{StaticResource ApprovalAcceptedBackgroundColor}"/>
    <SolidColorBrush x:Key="ApprovalAcceptedBorder" Color="{StaticResource ApprovalAcceptedBorderColor}"/>
    <SolidColorBrush x:Key="ApprovalAcceptedForeground" Color="{StaticResource ApprovalAcceptedForegroundColor}"/>
    <SolidColorBrush x:Key="ApprovalRejectedBackground" Color="{StaticResource ApprovalRejectedBackgroundColor}"/>
    <SolidColorBrush x:Key="ApprovalRejectedBorder" Color="{StaticResource ApprovalRejectedBorderColor}"/>
    <SolidColorBrush x:Key="ApprovalRejectedForeground" Color="{StaticResource ApprovalRejectedForegroundColor}"/>
    <SolidColorBrush x:Key="ModeButtonActiveForeground" Color="{StaticResource OverlayForegroundColor}"/>
    <SolidColorBrush x:Key="StatusReadyBrush" Color="{StaticResource StatusReadyColor}"/>
    <SolidColorBrush x:Key="StatusOfflineBrush" Color="{StaticResource StatusOfflineColor}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════
         CONTROL STYLES
    ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Mode Navigation Button - Emerald Style -->
    <Style x:Key="ModeButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="4 0"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource SubtleText}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="12 8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonBackground}"/>
                            <Setter Property="Foreground" Value="{StaticResource OverlayForeground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonActiveBackground}"/>
                            <Setter Property="Foreground" Value="{StaticResource OverlayForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Typography Styles -->
    <Style x:Key="TitleLargeTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource OverlayForeground}"/>
    </Style>
</ResourceDictionary>
